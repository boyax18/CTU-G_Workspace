Table accounts {
  account_id int [pk, increment]
  school_id varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  email varchar(150)

  requested_role_id int
  request_status enum('Pending', 'Approved', 'Rejected') [not null, default: 'Pending']

  is_active boolean [not null, default: false]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  reviewed_by int
  reviewed_at timestamp
  rejection_reason varchar(255)

  password_reset_token varchar(255)
  password_reset_token_expires timestamp

  is_staff boolean [not null, default: false]
  is_superuser boolean [not null, default: false]
}

Table users {
  user_id int [pk, increment]
  account_id int [not null, unique]
  first_name varchar(100)
  middle_name varchar(100)
  last_name varchar(100)
  suffix_name varchar(20)
}

Table roles {
  role_id int [pk, increment]
  role_name varchar(50) [not null, unique]
  description varchar(255)
  is_active boolean [not null, default: true]
}

Table services {
  service_id int [pk, increment]
  service_name varchar(100) [not null, unique]
  service_code varchar(100) [not null, unique]
  description varchar(255)
  is_active boolean [not null, default: true]
}

Table permissions {
  permission_id int [pk, increment]
  service_id int [not null]
  permission_code varchar(150) [not null, unique]
  permission_name varchar(100) [not null]
  module_name varchar(100) [not null]
  action_name varchar(50) [not null]
  description varchar(255)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table account_roles {
  account_role_id int [pk, increment]
  account_id int [not null]
  role_id int [not null]
  assigned_by int
  assigned_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (account_id, role_id) [unique]
  }
}

Table role_permissions {
  role_permission_id int [pk, increment]
  role_id int [not null]
  permission_id int [not null]
  is_active boolean [not null, default: true]
  granted_by int
  granted_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (role_id, permission_id) [unique]
  }
}

Table account_permissions {
  account_permission_id int [pk, increment]
  account_id int [not null]
  permission_id int [not null]
  effect enum('Grant', 'Deny') [not null]
  is_active boolean [not null, default: true]
  assigned_by int
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    (account_id, permission_id) [unique]
  }
}

Table access_audit_logs {
  access_audit_log_id int [pk, increment]
  actor_account_id int [not null]
  target_account_id int
  role_id int
  permission_id int
  action varchar(50) [not null]
  old_value json
  new_value json
  reason varchar(255)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Ref: users.account_id - accounts.account_id
Ref: accounts.requested_role_id > roles.role_id
Ref: accounts.reviewed_by > accounts.account_id

Ref: permissions.service_id > services.service_id

Ref: account_roles.account_id > accounts.account_id
Ref: account_roles.role_id > roles.role_id
Ref: account_roles.assigned_by > accounts.account_id

Ref: role_permissions.role_id > roles.role_id
Ref: role_permissions.permission_id > permissions.permission_id
Ref: role_permissions.granted_by > accounts.account_id

Ref: account_permissions.account_id > accounts.account_id
Ref: account_permissions.permission_id > permissions.permission_id
Ref: account_permissions.assigned_by > accounts.account_id

Ref: access_audit_logs.actor_account_id > accounts.account_id
Ref: access_audit_logs.target_account_id > accounts.account_id
Ref: access_audit_logs.role_id > roles.role_id
Ref: access_audit_logs.permission_id > permissions.permission_id
