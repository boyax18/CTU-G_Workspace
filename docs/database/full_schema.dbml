// 1. ACCOUNTS & USERS

Table accounts {
  account_id int [pk, increment]
  school_id varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  email varchar(150)

  requested_role_id int
  request_status enum('Pending', 'Approved', 'Rejected') [not null, default: 'Pending']

  is_active boolean [not null, default: false]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  reviewed_by int
  reviewed_at timestamp
  rejection_reason varchar(255)

  password_reset_token varchar(255)
  password_reset_token_expires timestamp

  is_staff boolean [not null, default: false]
  is_superuser boolean [not null, default: false]
}

Table users {
  user_id int [pk, increment]
  account_id int [not null, unique]
  first_name varchar(100)
  middle_name varchar(100)
  last_name varchar(100)
  suffix_name varchar(20)
}


// 2. ROLE-BASED ACCESS CONTROL (RBAC)

Table roles {
  role_id int [pk, increment]
  role_name varchar(50) [not null, unique]
  description varchar(255)
  is_active boolean [not null, default: true]
}

Table services {
  service_id int [pk, increment]
  service_name varchar(100) [not null, unique]
  service_code varchar(100) [not null, unique]
  description varchar(255)
  is_active boolean [not null, default: true]
}

Table permissions {
  permission_id int [pk, increment]
  service_id int [not null]
  permission_code varchar(150) [not null, unique]
  permission_name varchar(100) [not null]
  module_name varchar(100) [not null]
  action_name varchar(50) [not null]
  description varchar(255)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table account_roles {
  account_role_id int [pk, increment]
  account_id int [not null]
  role_id int [not null]
  assigned_by int
  assigned_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (account_id, role_id) [unique]
  }
}

Table role_permissions {
  role_permission_id int [pk, increment]
  role_id int [not null]
  permission_id int [not null]
  is_active boolean [not null, default: true]
  granted_by int
  granted_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (role_id, permission_id) [unique]
  }
}

Table account_permissions {
  account_permission_id int [pk, increment]
  account_id int [not null]
  permission_id int [not null]
  effect enum('Grant', 'Deny') [not null]
  is_active boolean [not null, default: true]
  assigned_by int
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

  indexes {
    (account_id, permission_id) [unique]
  }
}

Table access_audit_logs {
  access_audit_log_id int [pk, increment]
  actor_account_id int [not null]
  target_account_id int
  role_id int
  permission_id int
  action varchar(50) [not null]
  old_value json
  new_value json
  reason varchar(255)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}


// 3. ACADEMICS

Table courses {
  course_id int [pk, increment]
  course_code varchar(20) [not null, unique]
  course_name varchar(100)
  is_active boolean [not null, default: true]
}

Table school_years {
  school_year_id int [pk, increment]
  year_start int [not null]
  year_end int [not null]
  year_status varchar(20) [not null, default: 'Current']
}

Table school_periods {
  period_id int [pk, increment]
  school_year_id int [not null]
  semester varchar(20) [not null, note: 'First, Second']
  start_date date
  end_date date
  is_active boolean [not null, default: false]

  indexes {
    (school_year_id, semester) [unique]
  }
}

Table year_and_sections {
  year_and_section_id int [pk, increment]
  course_id int [not null]
  year enum('1', '2', '3', '4') [not null]
  section enum('A', 'B', 'C', 'D') [not null]

  indexes {
    (course_id, year, section) [unique]
  }
}

Table academic_profile {
  academic_profile_id int [pk, increment]
  user_id int [not null, unique]
  school_year_id int [not null]
  year_and_section_id int [not null]
  academic_status varchar(20) [not null, default: 'Enrolled']
}

Table class_advisers {
  class_adviser_id int [pk, increment]
  user_id int [not null]
  year_and_section_id int [not null, unique]
}


// 4. SSG FINANCE

Table full_amount {
  full_amount_id int [pk, increment]
  period_id int [not null]
  amount decimal(10,2) [not null]
  semester_status varchar(20) [not null, default: 'Current']
}

Table org_fee_payments {
  payment_id int [pk, increment]
  user_id int [not null]
  full_amount_id int [not null]
  amount decimal(10,2) [not null]
  payment_status varchar(20) [not null, note: 'Partial, Paid']
  received_by int [not null]
  payment_date timestamp [not null, default: `CURRENT_TIMESTAMP`]
  year_level_at_payment int
  section_at_payment varchar(50)
}

Table other_funds {
  fund_id int [pk, increment]
  source varchar(200)
  description text
  amount decimal(10,2) [not null]
  category varchar(50)
  received_by int [not null]
  received_date timestamp [not null, default: `CURRENT_TIMESTAMP`]
  period_id int [not null]
}

Table expenses {
  expense_id int [pk, increment]
  description text
  amount decimal(10,2) [not null]
  recorded_by int [not null]
  expense_date timestamp [not null, default: `CURRENT_TIMESTAMP`]
  period_id int [not null]
}

Table expense_images {
  image_id int [pk, increment]
  expense_id int [not null]
  image_path varchar(255) [not null]
  uploaded_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table receipts {
  receipt_id int [pk, increment]
  receipt_number varchar(50) [not null, unique]
  payment_id int [not null]
  issued_by int [not null]
}

Table signatures {
  signature_id int [pk, increment]
  account_id int [not null]
  signature_data mediumtext [not null, note: 'Base64 image']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  is_active boolean [not null, default: true]
}

Table reports {
  report_id int [pk, increment]
  report_type varchar(20) [not null, note: 'Event, Semester, Annual']
  title varchar(255) [not null]
  period_id int [not null]
  date_from date
  date_to date
  beginning_balance decimal(10,2) [not null, default: 0.00]
  total_revenue decimal(10,2) [not null, default: 0.00]
  total_expenses decimal(10,2) [not null, default: 0.00]
  running_balance decimal(10,2) [not null, default: 0.00]
  status varchar(20) [not null, default: 'Draft', note: 'Draft, Final']
  created_by int [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table report_items {
  item_id int [pk, increment]
  report_id int [not null]
  item_type varchar(20) [not null, note: 'Expense, Fund']
  item_ref_id int [not null, note: 'Polymorphic reference; requires application validation']
  description text
  amount decimal(10,2) [not null]
}

Table student_fee_exemptions {
  exemption_id int [pk, increment]
  user_id int [not null]
  period_id int [not null]

  indexes {
    (user_id, period_id) [unique]
  }
}


// 5. SCHOOL CLEARANCE

Table subjects {
  subject_id int [pk, increment]
  mis_code varchar(50) [not null, default: '']
  subject_code varchar(50) [not null]
  description varchar(200) [not null, default: '']
  is_active boolean [not null, default: true]
}

Table lec_units {
  lec_unit_id int [pk, increment]
  subject_id int [not null, unique]
  unit int [not null, default: 2]
}

Table lab_units {
  lab_unit_id int [pk, increment]
  subject_id int [not null, unique]
  unit int [not null, default: 2]
}

Table subject_teachers {
  subject_teachers_id int [pk, increment]
  subject_id int [not null]
  user_id int [not null]
  period_id int [not null]
  year_and_section_id int [not null]
  is_active boolean [not null, default: true]

  indexes {
    (subject_id, user_id, period_id, year_and_section_id) [unique]
  }
}

Table authorized_signatories {
  authorized_signatory_id int [pk, increment]
  position_title enum(
    'Organization Treasurer',
    'Computer Lab in-Charge',
    'Class Adviser',
    'Organization Adviser',
    'Department Chairperson'
  ) [not null]
  account_id int [note: 'Fixed signatory; null if vacant. Null for Class Adviser (from class_advisers) and Organization Treasurer (the account holding the Treasurer role in account_roles)']
  class_adviser_id int [unique, note: 'Only for Class Adviser rows; null for every other position']
  is_active boolean [not null, default: true]
}

Table organization_clearance_request {
  organization_clearance_request_id int [pk, increment]
  user_id int [not null]
  authorized_signatory_id int [not null]
  status varchar(20) [not null, default: 'Pending']
  period_id int [not null]
  requested_at datetime
  signed_at datetime
  signed_by_account_id int
  signature_id int

  indexes {
    (user_id, authorized_signatory_id, period_id) [unique]
  }
}

Table subject_clearance_request {
  subject_clearance_request_id int [pk, increment]
  user_id int [not null]
  subject_teachers_id int [not null]
  status varchar(20) [not null, default: 'Pending']
  period_id int [not null]
  requested_at datetime
  signed_at datetime
  signed_by_account_id int
  signature_id int

  indexes {
    (user_id, subject_teachers_id, period_id) [unique]
  }
}

Table clearance_messages {
  id int [pk, increment]
  sender_account_id int [not null]
  user_id int [not null]
  clearance_type varchar(20) [not null]
  message text [not null]
  sent_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  is_read boolean [not null, default: false]
}

Table announcements {
  announcement_id int [pk, increment]
  title varchar(255) [not null]
  body longtext [not null]
  type varchar(50) [default: 'General']
  posted_by_account_id int [not null]
  posted_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table user_notification_reads {
  user_id int [not null]
  announcement_id int [not null]
  read_at datetime [not null]

  indexes {
    (user_id, announcement_id) [pk]
  }
}


// 6. GROUP RATING

Table rating_sheets {
  sheets_id int [pk, increment]
  subject_teachers_id int [not null]
  period_id int [not null]
  title varchar(200) [not null]
  total_points decimal(5,2) [not null]
  status varchar(20) [not null, default: 'Draft', note: 'Draft, Open, Closed']
  created_by int [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table rating_criteria {
  criteria_id int [pk, increment]
  sheets_id int [not null]
  criteria_name varchar(150) [not null]
  sort_order int [not null, default: 0]
}

Table group_leader_invitation {
  invitation_id int [pk, increment]
  sheets_id int [not null]
  user_id int [not null]
  status varchar(20) [not null, default: 'Pending', note: 'Pending, Accepted, Declined']
  decline_reason text
  invited_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  responded_at datetime
  is_read boolean [not null, default: false]

  indexes {
    (sheets_id, user_id) [unique]
  }
}

Table group_names {
  group_id int [pk, increment]
  sheets_id int [not null]
  invitation_id int [not null, unique, note: 'The accepted leader invitation this group was created from']
  group_name varchar(150) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table group_members {
  group_member_id int [pk, increment]
  group_id int [not null]
  sheets_id int [not null]
  user_id int [not null]
  group_role varchar(20) [not null, default: 'Member', note: 'Leader, Member']

  indexes {
    (group_id, user_id) [unique]
    (sheets_id, user_id) [unique]
  }
}

Table rating_submissions {
  submission_id int [pk, increment]
  group_id int [not null]
  rater_id int [not null, note: 'The rater']
  status varchar(20) [not null, default: 'Draft', note: 'Draft, Submitted']
  submitted_at datetime

  indexes {
    (group_id, rater_id) [unique]
  }
}

Table group_rating_scores {
  score_id int [pk, increment]
  submission_id int [not null]
  criteria_id int [not null]
  group_member_id int [not null, note: 'The member being rated; must not equal the rater']
  score decimal(5,2) [not null]

  indexes {
    (submission_id, criteria_id, group_member_id) [unique]
  }
}


// 7. RELATIONSHIPS

// Accounts, users, and RBAC
Ref: users.account_id - accounts.account_id
Ref: accounts.requested_role_id > roles.role_id
Ref: accounts.reviewed_by > accounts.account_id

Ref: permissions.service_id > services.service_id

Ref: account_roles.account_id > accounts.account_id
Ref: account_roles.role_id > roles.role_id
Ref: account_roles.assigned_by > accounts.account_id

Ref: role_permissions.role_id > roles.role_id
Ref: role_permissions.permission_id > permissions.permission_id
Ref: role_permissions.granted_by > accounts.account_id

Ref: account_permissions.account_id > accounts.account_id
Ref: account_permissions.permission_id > permissions.permission_id
Ref: account_permissions.assigned_by > accounts.account_id

Ref: access_audit_logs.actor_account_id > accounts.account_id
Ref: access_audit_logs.target_account_id > accounts.account_id
Ref: access_audit_logs.role_id > roles.role_id
Ref: access_audit_logs.permission_id > permissions.permission_id

// Academics
Ref: school_periods.school_year_id > school_years.school_year_id
Ref: year_and_sections.course_id > courses.course_id
Ref: academic_profile.user_id - users.user_id
Ref: academic_profile.school_year_id > school_years.school_year_id
Ref: academic_profile.year_and_section_id > year_and_sections.year_and_section_id
Ref: class_advisers.user_id > users.user_id
Ref: class_advisers.year_and_section_id - year_and_sections.year_and_section_id

// SSG Finance
Ref: full_amount.period_id > school_periods.period_id
Ref: org_fee_payments.user_id > users.user_id
Ref: org_fee_payments.full_amount_id > full_amount.full_amount_id
Ref: org_fee_payments.received_by > accounts.account_id
Ref: other_funds.received_by > accounts.account_id
Ref: other_funds.period_id > school_periods.period_id
Ref: expenses.recorded_by > accounts.account_id
Ref: expenses.period_id > school_periods.period_id
Ref: expense_images.expense_id > expenses.expense_id
Ref: receipts.payment_id > org_fee_payments.payment_id
Ref: receipts.issued_by > accounts.account_id
Ref: signatures.account_id > accounts.account_id
Ref: reports.period_id > school_periods.period_id
Ref: reports.created_by > accounts.account_id
Ref: report_items.report_id > reports.report_id
Ref: student_fee_exemptions.user_id > users.user_id
Ref: student_fee_exemptions.period_id > school_periods.period_id

// School Clearance
Ref: lec_units.subject_id - subjects.subject_id
Ref: lab_units.subject_id - subjects.subject_id
Ref: subject_teachers.subject_id > subjects.subject_id
Ref: subject_teachers.user_id > users.user_id
Ref: subject_teachers.period_id > school_periods.period_id
Ref: subject_teachers.year_and_section_id > year_and_sections.year_and_section_id

Ref: authorized_signatories.account_id > accounts.account_id
Ref: authorized_signatories.class_adviser_id - class_advisers.class_adviser_id

Ref: organization_clearance_request.user_id > users.user_id
Ref: organization_clearance_request.authorized_signatory_id > authorized_signatories.authorized_signatory_id
Ref: organization_clearance_request.period_id > school_periods.period_id
Ref: organization_clearance_request.signed_by_account_id > accounts.account_id
Ref: organization_clearance_request.signature_id > signatures.signature_id

Ref: subject_clearance_request.user_id > users.user_id
Ref: subject_clearance_request.subject_teachers_id > subject_teachers.subject_teachers_id
Ref: subject_clearance_request.period_id > school_periods.period_id
Ref: subject_clearance_request.signed_by_account_id > accounts.account_id
Ref: subject_clearance_request.signature_id > signatures.signature_id

Ref: clearance_messages.sender_account_id > accounts.account_id
Ref: clearance_messages.user_id > users.user_id
Ref: announcements.posted_by_account_id > accounts.account_id
Ref: user_notification_reads.user_id > users.user_id
Ref: user_notification_reads.announcement_id > announcements.announcement_id

// Group Rating
Ref: rating_sheets.subject_teachers_id > subject_teachers.subject_teachers_id
Ref: rating_sheets.period_id > school_periods.period_id
Ref: rating_sheets.created_by > accounts.account_id
Ref: rating_criteria.sheets_id > rating_sheets.sheets_id
Ref: group_leader_invitation.sheets_id > rating_sheets.sheets_id
Ref: group_leader_invitation.user_id > users.user_id
Ref: group_names.sheets_id > rating_sheets.sheets_id
Ref: group_names.invitation_id - group_leader_invitation.invitation_id
Ref: group_members.group_id > group_names.group_id
Ref: group_members.sheets_id > rating_sheets.sheets_id
Ref: group_members.user_id > users.user_id
Ref: rating_submissions.group_id > group_names.group_id
Ref: rating_submissions.rater_id > group_members.group_member_id
Ref: group_rating_scores.submission_id > rating_submissions.submission_id
Ref: group_rating_scores.criteria_id > rating_criteria.criteria_id
Ref: group_rating_scores.group_member_id > group_members.group_member_id