
# Django settings
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key

# PostgreSQL settings
DB_NAME=ctug_integrated_system
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=localhost
DB_PORT=5432


# smtp settings
WORKSPACE_EMAIL_USERNAME=@gmail.com
WORKSPACE_EMAIL_APP_PASSWORD=passwordkry
WORKSPACE_EMAIL_FROM=@gmail.com
WORKSPACE_EMAIL_SMTP_ENABLED=1

# LAN access. List every host other devices will use to reach the Vite dev
# server (e.g. this machine's LAN IP), plus localhost. Set the public base URL
# to the LAN address so links in emails work from other devices.
WORKSPACE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.1.10
WORKSPACE_PUBLIC_BASE_URL=http://192.168.1.10:5173
